#!/bin/sh

# Package-data checksum:
# {{ .packages | toJson | sha256sum }}

set -eu

if (set -o pipefail) 2>/dev/null; then
    set -o pipefail
fi

readonly PLATFORM="{{- if eq .chezmoi.os "darwin" -}}darwin{{- else if eq .chezmoi.os "linux" -}}{{ lower .chezmoi.osRelease.id }}{{- else -}}{{ .chezmoi.os }}{{- end -}}"

readonly NL='
'

brew_formulae=
brew_casks=
apt_packages=
snap_packages=

log() {
    printf '==> \033[1m%s\033[0m\n' "$*"
}

# append LIST_NAME VALUE
# Adds VALUE as a new line to the list variable LIST_NAME, unless it is already present.
append() {
    eval "_append_list=\${$1}"

    case "$NL$_append_list$NL" in
        *"$NL$2$NL"*)
            return 0
            ;;
    esac

    if [ -z "$_append_list" ]; then
        eval "$1=\$2"
    else
        eval "$1=\$_append_list\$NL\$2"
    fi
}

# run_with_list LIST COMMAND [ARGUMENT...]
# Runs COMMAND with its arguments, followed by each line of LIST as a separate argument.
run_with_list() {
    _run_list="$1"
    shift

    _run_ifs="$IFS"
    IFS="$NL"
    set -f
    # shellcheck disable=SC2086
    set -- "$@" $_run_list
    set +f
    IFS="$_run_ifs"

    "$@"
}

# is_listed NAME LIST
# Succeeds if NAME, or NAME without its tap prefix, is a line in LIST.
is_listed() {
    printf '%s\n' "$2" | grep -Fqx -e "$1" -e "${1##*/}"
}

add_package() {
    specification="$1"

    case "$specification" in
        cask/*)
            append brew_casks "${specification#cask/}"
            ;;

        snap/*)
            append snap_packages "${specification#snap/}"
            ;;

        *)
            case "$PLATFORM" in
                darwin)
                    append brew_formulae "$specification"
                    ;;

                debian|ubuntu)
                    append apt_packages "$specification"
                    ;;
            esac
            ;;
    esac
}

install_brew_packages() {
    if ! command -v brew >/dev/null 2>&1; then
        log "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    installed_formulae="$(brew list --formula --full-name)"
    installed_casks="$(brew list --cask --full-name)"

    saved_ifs="$IFS"
    set -f

    IFS="$NL"
    for specification in $brew_formulae; do
        IFS="$saved_ifs"
        # Split the specification into words
        # shellcheck disable=SC2086
        set -- $specification

        [ "$#" -gt 0 ] ||
            continue

        if is_listed "$1" "$installed_formulae"; then
            continue
        fi

        log "Installing Homebrew formula: $specification..."
        brew install "$@"
    done
    IFS="$saved_ifs"

    IFS="$NL"
    for specification in $brew_casks; do
        IFS="$saved_ifs"
        # shellcheck disable=SC2086
        set -- $specification

        [ "$#" -gt 0 ] ||
            continue

        if is_listed "$1" "$installed_casks"; then
            continue
        fi

        log "Installing Homebrew cask: $specification..."
        brew install --cask "$@"
    done
    IFS="$saved_ifs"

    set +f
}

install_apt_packages() {
    log "Updating APT metadata..."
    sudo apt-get update

    if [ -n "$apt_packages" ]; then
        log "Installing APT packages..."
        run_with_list "$apt_packages" sudo apt-get install --yes
    fi
}

install_snap_packages() {
    [ -n "$snap_packages" ] || return 0

    if ! command -v snap >/dev/null 2>&1; then
        log "Installing snapd..."
        sudo apt-get install --yes snapd
    fi

    saved_ifs="$IFS"
    set -f

    IFS="$NL"
    for specification in $snap_packages; do
        IFS="$saved_ifs"
        # shellcheck disable=SC2086
        set -- $specification

        [ "$#" -gt 0 ] ||
            continue

        if snap list "$1" >/dev/null 2>&1; then
            continue
        fi

        log "Installing Snap package: $specification..."
        sudo snap install "$@"
    done
    IFS="$saved_ifs"

    set +f
}

main() {
    case "$PLATFORM" in
        darwin)
            install_brew_packages
            ;;

        debian|ubuntu)
            install_apt_packages
            install_snap_packages
            ;;
    esac
}

{{ define "emitPackage" }}
{{-   $entry := .entry }}
{{-   $platform := .platform }}
{{-   if kindIs "string" $entry }}
{{      printf "add_package %s" ($entry | quote) }}
{{-   else }}
{{-     range $defaultName, $overrides := $entry }}
{{-       $resolvedName := $defaultName }}
{{-       if and (kindIs "map" $overrides) (hasKey $overrides $platform) }}
{{-         $resolvedName = get $overrides $platform }}
{{-       end }}
{{      printf "add_package %s" ($resolvedName | quote) }}
{{-     end }}
{{-   end }}
{{- end }}

{{- $platform := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $platform = "darwin" }}
{{- else if eq .chezmoi.os "linux" }}
{{-   if index .chezmoi.osRelease "idLike" }}
{{-     $platform = lower .chezmoi.osRelease.idLike }}
{{-   else }}
{{-     $platform = lower .chezmoi.osRelease.id }}
{{-   end }}
{{- else }}
{{-   $platform = .chezmoi.os }}
{{- end }}

{{- range $groupName, $group := .packages }}
{{    printf "# %s" $groupName }}
{{-   if hasKey $group "common" }}
{{-     range $entry := get $group "common" -}}
{{        template "emitPackage" (dict "entry" $entry "platform" $platform) }}
{{-     end }}
{{-   end }}
{{-   if hasKey $group $platform }}
{{-     range $entry := get $group $platform -}}
{{        template "emitPackage" (dict "entry" $entry "platform" $platform) }}
{{-     end }}
{{    end }}
{{- end }}

main "$@"

# vim: set ft=sh:
